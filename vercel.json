{
  "version": 2,
  "buildCommand": "pnpm test -- server/auth-session.test.ts && pnpm check && vite build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron/mcmv-reminder", "schedule": "0 8 * * *" }
  ]
}
