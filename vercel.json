{
  "version": 2,
  "buildCommand": "pnpm exec vitest run server/auth-session.test.ts server/imports-esm.test.ts && pnpm check && vite build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron/mcmv-reminder", "schedule": "0 8 * * *" },
    { "path": "/api/cron/lead-card-due", "schedule": "0 11 * * *" },
    { "path": "/api/cron/dolores", "schedule": "0 10 * * *" },
    { "path": "/api/cron/dolores/08", "schedule": "0 11 * * *" },
    { "path": "/api/cron/dolores/09", "schedule": "0 12 * * *" },
    { "path": "/api/cron/dolores/10", "schedule": "0 13 * * *" },
    { "path": "/api/cron/dolores/11", "schedule": "0 14 * * *" },
    { "path": "/api/cron/dolores/12", "schedule": "0 15 * * *" },
    { "path": "/api/cron/dolores/13", "schedule": "0 16 * * *" },
    { "path": "/api/cron/dolores/14", "schedule": "0 17 * * *" },
    { "path": "/api/cron/dolores-avisos/15", "schedule": "0 18 * * *" },
    { "path": "/api/cron/dolores-avisos/16", "schedule": "0 19 * * *" },
    { "path": "/api/cron/dolores-avisos/17", "schedule": "0 20 * * *" },
    { "path": "/api/cron/dolores-avisos/18", "schedule": "0 21 * * *" },
    { "path": "/api/cron/dolores-avisos/19", "schedule": "0 22 * * *" }
  ]
}
